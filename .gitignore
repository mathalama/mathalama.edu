# ==========================================
# MathalamaEdu Root GitIgnore (Monorepo)
# ==========================================

# ------------------------------------------
# Next.js / Frontend (app/)
# ------------------------------------------
app/node_modules/
app/.next/
app/out/
app/build/
app/next-env.d.ts
app/.tsbuildinfo
app/.vercel

# ------------------------------------------
# Go / Backend
# ------------------------------------------
# Binaries and templates
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/

# Test coverage
*.out
*.cov
coverage.txt

# Go workspace
go.work
go.work.sum

# Go vendor (if using vendoring, uncomment if you want to ignore)
# vendor/

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ------------------------------------------
# Logs and Debug
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# OS & Editor Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs / Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
